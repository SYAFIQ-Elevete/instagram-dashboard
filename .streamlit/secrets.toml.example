# Copy this file to .streamlit/secrets.toml and fill in your values.
# Never commit secrets.toml to git.

# Team login password (change this!)
DASHBOARD_PASSWORD = "your_team_password_here"

# Instagram Graph API credentials (optional — enter in the sidebar instead)
INSTAGRAM_ACCESS_TOKEN = "your_long_lived_access_token"
INSTAGRAM_USER_ID      = "your_instagram_business_user_id"
